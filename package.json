{
  "name": "n8n-nodes-42min",
  "version": "0.1.1",
  "description": "n8n community node for 42min \u2014 scheduling, bookings and booking event triggers",
  "keywords": [
    "n8n-community-node-package",
    "42min",
    "scheduling",
    "calendar",
    "booking",
    "meetings"
  ],
  "license": "MIT",
  "homepage": "https://42min.us/help/api",
  "author": {
    "name": "42min",
    "email": "plus@42min.us"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/42min-us/n8n-nodes-42min.git"
  },
  "bugs": {
    "url": "https://github.com/42min-us/n8n-nodes-42min/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build && node scripts/copy-codex.mjs",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FortyTwoMinApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FortyTwoMin/FortyTwoMin.node.js",
      "dist/nodes/FortyTwoMin/FortyTwoMinTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.47.2",
    "@types/node": "^20.19.43",
    "n8n-workflow": "*",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
